# NextAuth Configuration
AUTH_SECRET=your-random-secret-here-at-least-32-characters
NEXTAUTH_URL=http://localhost:3000

# Google OAuth 2.0 Credentials
# Create at: https://console.cloud.google.com/apis/credentials
# Required scopes: openid email profile https://www.googleapis.com/auth/gmail.readonly
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth App Credentials
# Create at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/connect/github/callback
# Scopes: read:user, user:email
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
